# Hindsight stack configuration.
#
#   cp .env.example .env      # then edit the values below
#   docker compose up -d
#
# This file is read by docker compose for both variable interpolation and to
# inject settings into the hindsight container. The real `.env` is git-ignored.
# Any HINDSIGHT_API_* variable you add here is passed straight through to the
# container, so you can set anything from https://hindsight.vectorize.io even
# if it is not listed below.

# =============================================================================
# Database (external PostgreSQL)
# =============================================================================
# Used by the bundled `db` (pgvector) container AND to build the connection URL.
HINDSIGHT_DB_PASSWORD=change-me-please
HINDSIGHT_DB_USER=hindsight_user
HINDSIGHT_DB_NAME=hindsight_db
# Postgres major version -> pgvector image tag (pgvector/pgvector:pg<version>).
HINDSIGHT_DB_VERSION=18

# --- Using a fully external / managed PostgreSQL (RDS, Cloud SQL, CNPG, ...) ---
# Set the full URL below and it overrides the bundled `db` connection. The DB
# must have the pgvector extension available. Then stop running the bundled db:
# `docker compose up -d` will still try to start it, so comment out the `db`
# service + the hindsight `depends_on` block in docker-compose.yml, or run only
# `docker compose up -d hindsight` after doing so. Remember sslmode for managed DBs.
# HINDSIGHT_API_DATABASE_URL=postgresql://user:pass@db.example.com:5432/hindsight?sslmode=require

# =============================================================================
# LLM provider  (pick ONE block; OpenRouter is the default below)
# =============================================================================
# Embeddings + reranking are NOT set here on purpose: the full image runs them
# locally with its baked-in default models, which is what we want.

# --- OpenRouter (default; free models available, OpenAI-compatible) ----------
# Get a key at https://openrouter.ai/keys . Browse free models (":free" suffix)
# at https://openrouter.ai/models — availability changes, so pick a current one.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
HINDSIGHT_API_LLM_API_KEY=sk-or-your-openrouter-key
HINDSIGHT_API_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- NVIDIA NIM (free credits, OpenAI-compatible) ----------------------------
# Key at https://build.nvidia.com ; models like meta/llama-3.3-70b-instruct.
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# HINDSIGHT_API_LLM_API_KEY=nvapi-your-key
# HINDSIGHT_API_LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Google Gemini (free tier via AI Studio, native provider) ----------------
# Key at https://aistudio.google.com/apikey . No base_url needed.
# HINDSIGHT_API_LLM_PROVIDER=gemini
# HINDSIGHT_API_LLM_API_KEY=your-gemini-api-key
# HINDSIGHT_API_LLM_MODEL=gemini-2.0-flash

# --- Groq (free tier, native provider) ---------------------------------------
# Key at https://console.groq.com/keys .
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_API_KEY=gsk-your-key
# HINDSIGHT_API_LLM_MODEL=llama-3.3-70b-versatile

# --- Local model via the llama.cpp sidecar -----------------------------------
# Run with:  docker compose --profile local-llm up -d
# (Optionally override the GGUF the sidecar downloads.)
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=http://llama:8080/v1
# HINDSIGHT_API_LLM_API_KEY=not-needed
# HINDSIGHT_API_LLM_MODEL=gemma-4-e2b-it
# LLAMA_HF_REPO=bartowski/google_gemma-4-E2B-it-GGUF
# LLAMA_HF_FILE=google_gemma-4-E2B-it-Q4_K_M.gguf

# --- Local model via Ollama running on the host ------------------------------
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_LLM_API_KEY=not-needed
# HINDSIGHT_API_LLM_MODEL=qwen2.5:32b

# Optional: reasoning effort for models that support it (low | medium | high).
# HINDSIGHT_API_LLM_REASONING_EFFORT=low

# =============================================================================
# Hindsight version (full image tag). `latest` = current full image.
# =============================================================================
# HINDSIGHT_VERSION=latest
