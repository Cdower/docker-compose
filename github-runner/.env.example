# GitHub Actions self-hosted runner — NON-SECRET configuration.
#
#   cp .env.example .env      # then edit the values below
#
# The registration TOKEN is intentionally NOT here. It is read from your device
# keychain at start time by the wrapper scripts (never written to disk). See the
# README: "Storing the token". The real .env is git-ignored.

# Where the runner registers. A repo, org, or enterprise URL:
#   repo: https://github.com/<owner>/<repo>
#   org:  https://github.com/<org>
RUNNER_URL=https://github.com/your-org/your-repo

# Display name in GitHub > Settings > Actions > Runners. Empty = container hostname.
RUNNER_NAME=

# Comma-separated labels used to target this runner from workflows (`runs-on`).
# Leave unset to use the platform default (macOS: self-hosted,linux,arm64 —
# Linux: self-hosted,linux,x64); enabling docker-in-job (see RUNNER_DOCKER_IN_JOB
# below) then adds a `docker` label. If you set RUNNER_LABELS here it is used
# verbatim — include `docker` yourself if you want the docker-in-job label.
# RUNNER_LABELS=self-hosted,docker

# Docker-in-job is OPT-IN. Set to 1 to layer docker-compose.<platform>.override.yml,
# which mounts the host Docker socket (so steps can run docker/build/compose) and
# adds the `docker` label. SECURITY: this gives jobs root-equivalent control of the
# host's Docker — only enable it for trusted repos/workflows. See the README.
# RUNNER_DOCKER_IN_JOB=1

# Runner group (Default unless you use org/enterprise runner groups).
RUNNER_GROUP=Default

# Work directory (relative to the persisted /runner dir) where repos are checked out.
RUNNER_WORKDIR=_work

# Extra config.sh flags. Examples:
#   --ephemeral            # single-job runner; auto-unregisters after one job
#   --no-default-labels    # only use the labels in RUNNER_LABELS
RUNNER_EXTRA_ARGS=

# Pin a runner version (e.g. 2.328.0), or leave "latest" to resolve at build time.
RUNNER_VERSION=latest

# Advanced: the keychain entry the helper scripts read the token from.
#   macOS: `security` service name   |   Linux: secret-tool "service" attribute.
# RUNNER_TOKEN_KEYCHAIN_SERVICE=github-actions-runner-token

# =============================================================================
# Build-time options (passed to `docker compose build` as build args)
# =============================================================================
# Docker-in-job: the image always ships the Docker CLI (+ buildx/compose plugins).
# Mounting the host Docker socket is opt-in via the override file — turn it on with
# RUNNER_DOCKER_IN_JOB=1 (above). To slim the image so it has no Docker CLI at all,
# set this false and leave docker-in-job off.
# INSTALL_DOCKER_CLI=true
# Only needed if Docker's apt repo has no package list for your Ubuntu codename
# yet — set a supported one (e.g. noble). The build auto-falls back to noble too.
# DOCKER_APT_CODENAME=
