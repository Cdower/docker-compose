# IPsec VPN server credentials (hwdsl2/ipsec-vpn-server).
#
#   cp vpn-server-secret.env.example vpn-server-secret.env   # then edit the values below
#   docker compose -f vpn-server.yml up -d
#
# vpn-server.yml reads the real `vpn-server-secret.env`, which is git-ignored
# by the `*secret.env` rule. Keep real values out of this template.
VPN_IPSEC_PSK=your_ipsec_pre_shared_key
VPN_USER=your_vpn_username
VPN_PASSWORD=your_vpn_password
